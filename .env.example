# SeceoKnight DLP - Environment Configuration
# Copy this file to .env and configure with your values

# ============================================
# SECURITY SETTINGS (CHANGE THESE!)
# ============================================
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
JWT_SECRET=change-this-to-a-random-jwt-secret-min-32-chars
ENCRYPTION_KEY=change-this-to-a-random-encryption-key
POSTGRES_PASSWORD=change-this-strong-postgres-password
MONGODB_PASSWORD=change-this-strong-mongodb-password
REDIS_PASSWORD=change-this-strong-redis-password
OPENSEARCH_PASSWORD=change-this-strong-opensearch-password

# ============================================
# SIEM SINGLE SIGN-ON
# ============================================
# Empty DLP_SSO_SECRET and empty SIEM_JWKS_URL = SSO disabled
# (/auth/sso/exchange returns 503).
#
# The SIEM's exchange token names how it was signed in its own `alg`
# header, so whichever of the two you configure below is what the DLP
# uses to verify it -- see server/app/core/sso_verify.py.
DLP_SSO_SECRET=

# ── RS256/JWKS (preferred over the shared secret above) ────────────────
# With DLP_SSO_SECRET the DLP holds a key that can FORGE SIEM tokens, not
# just verify them. Point this at the SIEM's JWKS endpoint instead and the
# DLP holds only a public key -- it can verify but never forge. Clear
# DLP_SSO_SECRET once this is working to retire symmetric signing entirely.
SIEM_JWKS_URL=
# PEM path (inside the container) to pin the JWKS host's TLS certificate.
# Empty = system trust store, correct for a publicly-issued certificate.
# A SIEM on an internal network usually presents a self-signed
# certificate; point this at that certificate or its issuing CA rather
# than disabling verification -- the JWKS IS the trust anchor for every
# RS256 login. See server/app/core/sso_jwks.py.
# The manager container already mounts ./config as /etc/seceoknight:ro
# (docker-compose.prod.yml) -- drop the pinned PEM in ./config/ on the
# host and point this at /etc/seceoknight/<filename>.pem, no new volume
# mount needed.
#   sudo bash sso-cert.sh fetch <siem-host>:<port>   # takes it, confirms it, installs it
#   sudo bash sso-cert.sh check                      # proves the manager can fetch the JWKS
# See DEPLOYMENT.md's "SIEM single sign-on" section for the full walkthrough.
SIEM_JWKS_CA_BUNDLE=
SSO_JWKS_CACHE_SECONDS=600
# Must match what the SIEM puts in the token's `aud` claim.
SSO_AUDIENCE=seceoknight-dlp
SSO_CLOCK_LEEWAY_SECONDS=60
SSO_REQUIRE_EXP=true
SSO_NONCE_TTL_SECONDS=300
SSO_MAX_TOKEN_AGE_SECONDS=600
# An SSO-vouched session skips the IP allowlist (password logins stay
# gated). See app/middleware/ip_allowlist.py's _is_sso_session.
SSO_ALLOWLIST_BYPASS=true

# ── Role/attribute propagation (server/app/core/sso_roles.py) ──────────
# The SIEM's role vocabulary (Administrator/L1/L2/L3 x read-write/
# read-only) maps onto existing DLP roles. Every field below is optional
# on the SIEM's side -- omitting all of them behaves exactly as if this
# section didn't exist.
# Ceiling on the DLP role an SSO login can ever receive -- bounds what a
# forged/misconfigured token can grant, independent of RS256 vs HS256.
SSO_MAX_ROLE=ADMIN
# Role for a login whose SIEM role claim is missing/unrecognised.
SSO_DEFAULT_ROLE=VIEWER
# Create the DLP account on first SSO login instead of rejecting it. Off
# by default -- SeceoKnight's contract is that the SIEM seeds accounts
# itself via POST /api/v1/users using an admin session obtained from
# /auth/sso/exchange, so this endpoint stays a pure login unless you
# opt in.
SSO_JIT_PROVISION=false
# Re-apply the SIEM's role/department/clearance on every SSO login. Only
# ever touches accounts SSO itself created or claimed (users.sso_managed);
# an admin editing such a user's role by hand in the DLP UI detaches it
# permanently instead of having the edit revert at the next login.
SSO_SYNC_ON_LOGIN=true
# Optional JSON override of the SIEM->DLP role table. Empty = built-in map.
# Example: SSO_ROLE_MAP={"L3":{"rw":"ANALYST","ro":"ANALYST"},"L1":"VIEWER"}
SSO_ROLE_MAP=

# ============================================
# TIMEZONE CONFIGURATION
# ============================================
# Timestamps are stored in UTC; this controls display timezone in API responses.
# Examples: UTC, Asia/Kolkata, US/Eastern, Europe/London, America/New_York
APP_TIMEZONE=UTC

# ============================================
# NETWORK CONFIGURATION
# ============================================
# Your server's domain name or IP address.
# Used for CORS, HSTS, and certificate generation.
HOST_IP=your-ubuntu-server-ip

# ── SSL / TLS ──────────────────────────────
# Path to your TLS certificates (relative to the project root).
# Generate them with:
#   Real domain:  bash scripts/generate-certs.sh --domain dlp.mycompany.com --email admin@mycompany.com
#   IP / local:   bash scripts/generate-certs.sh --self-signed
TLS_CERT_PATH=./certs

# NOTE: Dashboard and API are now served through Nginx on ports 80/443.
# Access the platform at https://<HOST_IP> or https://<your-domain>
# DASHBOARD_HOST_PORT is no longer used — Nginx handles routing.

# NOTE: VITE_API_URL is NOT needed when using pre-built GHCR images.
# The dashboard uses relative URLs (/api/v1) and nginx proxies to the backend.

# ============================================
# DATABASE SETTINGS
# ============================================
# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=seceoknight
POSTGRES_DB=seceoknight

# MongoDB Configuration
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_DB=seceoknight

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# OpenSearch Configuration (Event Storage & Search)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change-this-strong-opensearch-password
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=seceoknight

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=production
DEBUG=False
PORT=55000
APP_NAME=SeceoKnight DLP
APP_VERSION=2.0.0

# ============================================
# CORS SETTINGS (Add your dashboard URLs)
# ============================================
# SECURITY: CORS and trusted-host allowlists.
# The dashboard is served from the same origin as the API via the nginx
# reverse proxy, so no cross-origin access is needed. Wide-open "*" was
# removed — set these to the explicit hostname(s) you serve the dashboard
# under in production. Example:
#   CORS_ORIGINS=["https://dlp.mycompany.com"]
#   ALLOWED_HOSTS=dlp.mycompany.com,127.0.0.1
# Set these to your actual domain once SSL is configured.
# Examples:
#   CORS_ORIGINS=["https://dlp.mycompany.com"]
#   ALLOWED_HOSTS=dlp.mycompany.com,127.0.0.1
CORS_ORIGINS=["https://localhost","https://127.0.0.1"]
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# EMAIL / SMTP (Alerts + Scheduled Reports)
# ============================================
# Used for: security alerts, scheduled PDF reports (daily/weekly/monthly)
# Gmail: use an App Password (not your account password)
#   → Google Account → Security → 2-Step Verification → App passwords
# Office 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@seceoknight.com
SMTP_FROM_NAME=SeceoKnight DLP
SMTP_TLS=true

# ============================================
# REPORTS STORAGE
# ============================================
# Directory where generated PDF/CSV reports are stored on the server.
# Must be writable by the manager container.
REPORTS_DIR=/app/reports

# ============================================
# WAZUH SIEM INTEGRATION (OPTIONAL)
# ============================================
WAZUH_ENABLED=false
WAZUH_HOST=your-wazuh-server
WAZUH_PORT=55000
WAZUH_USER=wazuh-api-user
WAZUH_PASSWORD=wazuh-api-password

# ============================================
# LOGGING SETTINGS
# ============================================
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/seceoknight
MAX_LOG_SIZE_MB=100
LOG_RETENTION_DAYS=30

# ============================================
# QUARANTINE SETTINGS
# ============================================
QUARANTINE_ENABLED=true
QUARANTINE_PATH=/var/quarantine/dlp
QUARANTINE_MAX_SIZE_GB=50

# ============================================
# PERFORMANCE TUNING
# ============================================
MAX_WORKERS=4
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30

# ============================================
# COMPLIANCE SETTINGS
# ============================================
COMPLIANCE_MODE=GDPR,HIPAA,PCI-DSS
DATA_RETENTION_DAYS=90
AUDIT_LOG_ENABLED=true
