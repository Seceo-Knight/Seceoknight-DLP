    ],
    "enabled": true
  },
  {
    "name": "Private Key Header",
    "description": "Detects RSA/DSA/EC/OpenSSH/encrypted private key headers and PGP private key blocks",
    "type": "regex",
    "pattern": "-----BEGIN (RSA |DSA |EC |OPENSSH |ENCRYPTED )?PRIVATE KEY-----|-----BEGIN PGP PRIVATE KEY BLOCK-----",
