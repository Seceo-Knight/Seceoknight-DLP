  {
    "name": "Generic API Key",
    "description": "Detects generic API keys in code",
    "type": "regex",
    "pattern": "(?i)(api[_-]?key|apikey|access[_-]?token)[\"']?\\s*[:=]\\s*[\"']?([a-zA-Z0-9_\\-]{32,})[\"']?",
