[
  {
    "name": "US Social Security Number (SSN)",
    "description": "Detects US Social Security Numbers in XXX-XX-XXXX format",
    "type": "regex",
    "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
    "threshold": 1,
    "weight": 0.9,
    "priority": 10,
    "label": "Restricted",
    "classification_labels": [
      "PII",
      "SSN"
    ],
    "severity": "critical",
    "category": "PII",
    "tags": [
      "us",
      "government_id"
    ],
    "enabled": true
  },
  {
    "name": "Credit Card Number",
    "description": "Detects credit card numbers (Visa, MasterCard, Discover: 16-digit; Amex: 15-digit; Diners Club: 14-digit). Validated by Luhn checksum downstream in classification_engine.py, so a format match alone doesn't count as detected.",
    "type": "regex",
    "pattern": "\\b(?:(?:\\d{4}[\\s-]?){3}\\d{4}|3[47]\\d{2}[\\s-]?\\d{6}[\\s-]?\\d{5}|3(?:0[0-5]\\d|[68]\\d{2})[\\s-]?\\d{6}[\\s-]?\\d{4})\\b",
    "threshold": 1,
    "weight": 0.95,
    "priority": 5,
    "label": "Restricted",
    "classification_labels": [
      "PCI",
      "FINANCIAL",
      "CREDIT_CARD"
    ],
    "severity": "critical",
    "category": "Financial",
    "tags": [
      "pci-dss",
      "payment"
    ],
    "enabled": true
  },
  {
    "name": "Email Address",
    "description": "Detects email addresses",
    "type": "regex",
    "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
    "threshold": 1,
    "weight": 0.3,
    "priority": 80,
    "label": "Internal",
    "classification_labels": [
      "CONTACT",
      "EMAIL"
    ],
    "severity": "medium",
    "category": "PII",
    "tags": [
      "contact"
    ],
    "enabled": true
  },
  {
    "name": "US Phone Number",
    "description": "Detects US phone numbers in various formats",
    "type": "regex",
    "pattern": "\\b(?:\\+?1[\\s.-]?)?\\(?\\d{3}\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}\\b",
    "threshold": 1,
    "weight": 0.4,
    "priority": 70,
    "label": "Internal",
    "classification_labels": [
      "CONTACT",
      "PHONE"
    ],
    "severity": "medium",
    "category": "PII",
    "tags": [
      "contact"
    ],
    "enabled": true
  },
  {
    "name": "Indian Aadhaar Number",
    "description": "Detects Indian Aadhaar numbers (12-digit UID)",
    "type": "regex",
    "pattern": "\\b\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}\\b",
    "threshold": 1,
    "weight": 0.9,
    "priority": 10,
    "label": "Restricted",
    "classification_labels": [
      "PII",
      "AADHAAR",
      "INDIAN_ID"
    ],
    "severity": "critical",
    "category": "PII",
    "tags": [
      "india",
      "government_id"
    ],
    "enabled": true
  },
  {
    "name": "Indian PAN Card",
    "description": "Detects Indian Permanent Account Number (PAN). The 4th letter is constrained to the real holder-type code set (P=individual, C=company, H=HUF, A=AOP, B=body of individuals, G=govt, J=artificial judicial person, L=local authority, F=firm, T=trust) to cut down on false positives from unconstrained 5-letter+4-digit+1-letter strings.",
    "type": "regex",
    "pattern": "\\b[A-Z]{3}[PCHABGJLFT][A-Z]\\d{4}[A-Z]\\b",
    "threshold": 1,
    "weight": 0.9,
    "priority": 10,
    "label": "Restricted",
    "classification_labels": [
      "TAX",
      "PAN",
      "INDIAN_ID"
    ],
    "severity": "critical",
    "category": "Financial",
    "tags": [
      "india",
      "tax"
    ],
    "enabled": true
  },
  {
    "name": "Indian IFSC Code",
    "description": "Detects Indian IFSC (bank branch) codes",
