  {
    "name": "UPI ID",
    "description": "Detects Indian UPI payment IDs",
    "type": "regex",
    "pattern": "\\b[\\w.-]+@(paytm|phonepe|ybl|okaxis|okhdfcbank|oksbi|okicici|axl|ibl|fbl|airtel|amazonpay)\\b",
    "regex_flags": [
      "IGNORECASE"
    ],
    "threshold": 1,
    "weight": 0.7,
    "priority": 30,
    "label": "Confidential",
    "classification_labels": [
      "PAYMENT",
      "UPI"
    ],
    "severity": "high",
    "category": "Financial",
    "tags": [
      "india",
      "payment",
      "upi"
    ],
    "enabled": true
  },
  {
    "name": "IP Address (IPv4)",
    "description": "Detects IPv4 addresses",
    "type": "regex",
    "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
    "threshold": 1,
    "weight": 0.3,
    "priority": 90,
    "label": "Public",
    "classification_labels": [
      "NETWORK",
      "IP_ADDRESS"
    ],
    "severity": "low",
    "category": "Network",
    "tags": [
      "network"
    ],
    "enabled": true
  },
  {
    "name": "AWS Access Key",
    "description": "Detects AWS access key IDs -- AKIA (long-term), ASIA (temporary/STS, common in CI/CD), AROA (assumed-role), and AIDA (IAM user) prefixes",
    "type": "regex",
    "pattern": "\\b((?:AKIA|ASIA|AROA|AIDA)[0-9A-Z]{16})\\b",
    "threshold": 1,
    "weight": 0.95,
    "priority": 5,
    "label": "Restricted",
    "classification_labels": [
      "CREDENTIAL",
      "AWS",
      "API_KEY"
    ],
    "severity": "critical",
    "category": "Credentials",
    "tags": [
      "aws",
      "cloud",
      "secrets"
    ],
    "enabled": true
  },
  {
    "name": "AWS Secret Access Key",
    "description": "Detects AWS secret access keys -- requires an adjacent aws_secret_access_key label so an arbitrary 40-char base64-ish string isn't flagged on its own",
    "type": "regex",
    "pattern": "(?i)aws_secret_access_key\\s*[:=]\\s*[\"']?([A-Za-z0-9/+=]{40})[\"']?",
    "threshold": 1,
    "weight": 0.95,
    "priority": 5,
    "label": "Restricted",
    "classification_labels": [
      "CREDENTIAL",
      "AWS",
      "API_KEY"
    ],
    "severity": "critical",
    "category": "Credentials",
    "tags": [
      "aws",
      "cloud",
      "secrets"
    ],
    "enabled": true
  },
  {
    "name": "GitHub Personal Access Token",
    "description": "Detects GitHub tokens: classic ghp_/gho_/ghu_/ghs_/ghr_ (OAuth, GitHub App user/server tokens, refresh tokens) and modern fine-grained github_pat_ tokens",
    "type": "regex",
    "pattern": "\\b(gh[oprsu]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82})\\b",
    "threshold": 1,
    "weight": 0.95,
    "priority": 5,
    "label": "Restricted",
    "classification_labels": [
      "CREDENTIAL",
      "GITHUB",
      "API_KEY"
    ],
    "severity": "critical",
    "category": "Credentials",
    "tags": [
      "github",
      "secrets"
    ],
    "enabled": true
  },
