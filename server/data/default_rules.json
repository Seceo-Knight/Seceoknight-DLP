      "BANKING",
      "IFSC"
    ],
    "severity": "high",
    "category": "Financial",
    "tags": [
      "india",
      "banking"
    ],
    "enabled": true
  },
  {
    "name": "Indian Mobile Number",
    "description": "Detects Indian mobile numbers",
