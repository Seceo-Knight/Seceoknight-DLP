  {
    "name": "Database Connection String",
    "description": "Detects database connection strings (JDBC, native Postgres/MySQL URIs, MongoDB, Redis, AMQP)",
    "type": "regex",
    "pattern": "(jdbc:(mysql|postgresql|oracle|sqlserver)://|mongodb://|mongodb\\+srv://|redis://|rediss://|postgres(?:ql)?://|mysql://|amqp://|amqps://)",
    "regex_flags": [
      "IGNORECASE"
    ],
    "threshold": 1,
    "weight": 0.85,
    "priority": 15,
    "label": "Restricted",
    "classification_labels": [
      "CREDENTIAL",
      "DATABASE",
      "CONNECTION_STRING"
    ],
    "severity": "critical",
    "category": "Credentials",
    "tags": [
      "database",
